# Firebase service account keys — backend-only admin credentials. These must
# never land in the app repo: anything shipped in an APK/IPA is extractable,
# and this key can send push to every user and read/write the whole project.
*service-account*.json
*firebase-adminsdk*.json
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
